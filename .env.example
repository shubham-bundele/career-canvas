# CareerCanvas — Environment Variables
# Copy to .env.local for local development
# Add to Vercel dashboard for Preview/Production

# ===== Public (safe for browser) =====
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...YOUR_ANON_KEY
PUBLIC_SITE_URL=http://localhost:8080

# Auth method toggles
AUTH_MAGIC_LINK_ENABLED=false
AUTH_GOOGLE_ENABLED=false

# ===== Private (server-side ONLY — never in browser) =====
SUPABASE_SERVICE_ROLE_KEY=eyJ...YOUR_SERVICE_ROLE_KEY

# AI Integration (Groq — free tier, no credit card needed)
# Get key at https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY
